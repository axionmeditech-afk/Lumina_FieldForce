PORT=5000
JWT_SECRET=replace-with-strong-random-secret
# Required only once when no approved admin exists. Generate at least 24 random
# characters and provide it in the x-initial-admin-token request header.
INITIAL_ADMIN_SETUP_TOKEN=replace-with-a-strong-one-time-bootstrap-secret
EXPO_PUBLIC_API_URL=https://lumina-fieldforce-api.onrender.com

# Hosted routing and geocoding. Keep the API key server-side; the mobile app
# calls these services through this backend. STADIA_MAPS_BASE_URL is optional.
STADIA_MAPS_API_KEY=
STADIA_MAPS_BASE_URL=https://api.stadiamaps.com
GEOSPATIAL_TIMEOUT_MS=9000

# Optional self-hosted fallback used only when STADIA_MAPS_API_KEY is empty.
GEOCODER_BASE_URL=
ROUTER_BASE_URL=
OSM_USER_AGENT=LuminaFieldForce/1.0 operations@example.com

# Existing employee accounts and attendance persistence
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=false

EXPO_PUBLIC_ATTENDANCE_REFRESH_MS=30000
# Background checkout is enabled through Account & Access in a native build.

# Office location search and native map preview
MAPPLS_PLACES_API_KEY=
MAPPLS_REST_API_KEY=
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional existing employee/attendance integration
DOLIBARR_ENDPOINT=
DOLIBARR_API_KEY=
