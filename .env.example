PORT=5000
JWT_SECRET=replace-with-strong-random-secret
EXPO_PUBLIC_API_URL=http://localhost:5000

# Existing employee accounts and attendance persistence
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=false

EXPO_PUBLIC_ATTENDANCE_REFRESH_MS=30000
# Background checkout is enabled through Account & Access in a native build.

# Office location search and native map preview
MAPPLS_PLACES_API_KEY=
MAPPLS_REST_API_KEY=
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional existing employee/attendance integration
DOLIBARR_ENDPOINT=
DOLIBARR_API_KEY=
