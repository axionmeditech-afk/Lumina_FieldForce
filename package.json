{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "build": "npm run server:build",
    "expo:dev": "set EXPO_NO_DOCTOR=1&& set EXPO_NO_DEPENDENCY_VALIDATION=1&& node ./node_modules/expo/bin/cli start --android",
    "android": "node ./node_modules/expo/bin/cli run:android",
    "ios": "node ./node_modules/expo/bin/cli run:ios",
    "start:expo": "set EXPO_OFFLINE=1&& set EXPO_NO_DOCTOR=1&& set EXPO_NO_DEPENDENCY_VALIDATION=1&& node ./node_modules/expo/bin/cli start",
    "start:lan": "set EXPO_OFFLINE=1&& set EXPO_NO_DOCTOR=1&& set EXPO_NO_DEPENDENCY_VALIDATION=1&& node ./node_modules/expo/bin/cli start --host lan --port 8081",
    "start:tunnel": "set EXPO_NO_DOCTOR=1&& set EXPO_NO_DEPENDENCY_VALIDATION=1&& node ./node_modules/expo/bin/cli start --tunnel",
    "start:web": "set EXPO_OFFLINE=1&& set EXPO_NO_DOCTOR=1&& set EXPO_NO_DEPENDENCY_VALIDATION=1&& node ./node_modules/expo/bin/cli start --web",
    "server:dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "expo:start:static:build": "set EXPO_NO_DOCTOR=1&& set EXPO_NO_DEPENDENCY_VALIDATION=1&& node ./node_modules/expo/bin/cli start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server_dist",
    "server:prod": "node --env-file-if-exists=.env server_dist/index.js",
    "db:push": "drizzle-kit push",
    "start": "node server.js",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "typecheck": "tsc --noEmit",
    "test:attendance": "tsx --test tests/attendance.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.83.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "esbuild": "^0.25.11",
    "expo": "^58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "express": "^5.0.1",
    "fs-extra": "^11.3.4",
    "mysql2": "^3.18.2",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.0",
    "tsx": "^4.20.6",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@react-native-community/cli": "^20.2.0",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "drizzle-kit": "^0.18.1",
    "eas-cli": "^0.0.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "private": true
}
